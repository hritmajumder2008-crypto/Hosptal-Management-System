<!DOCTYPE html>
<html>
<head>
    <title>Patient Registration</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }
        form {
            text-align: center;
        }
    </style>
</head>
<body>
    <h1>Patient Registration</h1>
    <form>
        <label>Patient ID:</label>
        <input type="number">
        <br><br>
        <label>Name:</label>
        <input type="text">
        <br><br>
        <label>Age:</label>
        <input type="number">
        <br><br>
        <label>Gender:</label>
        <input type="text">
        <br><br>
        <label>Contact:</label>
        <input type="text">
        <br><br>
        <button type="submit">Register Patient</button>
    </form>
</body>
</html>
